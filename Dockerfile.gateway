FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/gateway ./cmd/gateway

FROM alpine:3.21
RUN apk add --no-cache iptables iproute2 wireguard-tools ipset curl libqrencode-tools
COPY --from=builder /src/bin/gateway /usr/local/bin/gateway
ENTRYPOINT ["gateway"]
CMD ["-config", "/etc/gateway/gateway.yaml"]
